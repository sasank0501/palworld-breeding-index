    "build-pal-extras": "node scripts/build-pal-extras.mjs",
    "build-models": "node scripts/build-pal-models.mjs",
    "render-portraits": "node scripts/render-portraits.mjs",
    "build-portraits": "node scripts/build-portraits.mjs",
    "make-demo-roster": "node scripts/make-demo-roster.mjs",
    "audit-a11y": "node scripts/audit-a11y.mjs",
