node_modules/
dist/

# Imported from a local save by `npm run import-save` — personal, and regenerated
# every time you play. Never commit it.
public/roster.json
dist-ssr/
*.local
.DS_Store
.vite/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# Local Claude Code permissions — contains absolute machine paths.
# `*.local` above does not match this: the file ends in .json.
.claude/settings.local.json

# tsc -b incremental cache, rewritten on every build
tsconfig.tsbuildinfo

# Third-party portraits, regenerable with `npm run fetch-images`
public/pals/

# Everything below is derived from Pocketpair's game files, extracted from a copy
# of the game you own by `npm run build-portraits`. The repo ships none of it.

# Chibi stills rendered from the models (scripts/render-portraits.mjs).
public/pal-portraits/

# 3D models built by scripts/build-pal-models.mjs from the local extraction, and
# the smaller set the portfolio build ships (`npm run build-models -- --lite`).
public/pal-models/
public/pal-models-lite/

# The game's work-suitability and element icons (scripts/fetch-work-icons.mjs).
public/work-icons/
public/element-icons/

# Screenshots and the draft for the Reddit post: they show game art.
reddit/

# Full-asset build for the portfolio site (`npm run build:resume`). Deployed from
# a private place, never committed.
dist-resume/

# Extraction tooling: the .NET build output, the downloaded type mappings, and
# the raw meshes/textures staged out of the pak.
scripts/pal-textures/bin/
scripts/pal-textures/obj/
scripts/pal-textures/mappings/
scripts/pal-textures/out/
scripts/.cache/

# Chibi review sandbox: a local tool for checking model builds. App.tsx loads
# it only if present (import.meta.glob), so a clone without it still builds.
src/routes/ChibiReview.tsx
src/design/chibi.css
